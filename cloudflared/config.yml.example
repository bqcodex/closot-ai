# Cloudflare Tunnel configuration template
# Copy to ~/.cloudflared/config.yml and fill in your tunnel ID

# Your tunnel UUID — get this after running: cloudflared tunnel create <name>
tunnel: YOUR_TUNNEL_UUID_HERE

# Path to the tunnel credentials JSON file (auto-generated by cloudflared)
credentials-file: ~/.cloudflared/YOUR_TUNNEL_UUID_HERE.json

ingress:
  # EDIT: Replace with your actual domain/subdomain pointing to this machine
  - hostname: ai.yourdomain.com
    service: http://localhost:8000

  # Default catch-all — must be last
  - service: http_status:404
